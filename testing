# ------------------------------------------------------------
# DefenderSessionHelper Code Integrity
# ------------------------------------------------------------

$f = Get-ChildItem "$env:ProgramData\Microsoft\Windows Defender\Platform" `
    -Filter DefenderSessionHelper.exe `
    -Recurse `
    -ErrorAction SilentlyContinue |
    Select-Object -First 1 -ExpandProperty FullName

$f

Get-AuthenticodeSignature $f |
    Format-List Status,StatusMessage,SignerCertificate

Get-FileHash $f -Algorithm SHA256

Get-WinEvent -FilterHashtable @{
    LogName = 'Microsoft-Windows-CodeIntegrity/Operational'
    Id      = 3004
} -ErrorAction SilentlyContinue |
    Where-Object { $_.Message -match 'DefenderSessionHelper' } |
    Select-Object TimeCreated,Id,Message |
    Format-List
