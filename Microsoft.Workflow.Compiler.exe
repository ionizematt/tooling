1. Create the benign C# file
cd $env:USERPROFILE

@'
using System;
using System.Workflow.ComponentModel;

public class Run : Activity
{
    public Run()
    {
        Console.WriteLine("Ionize test - 12 Oct 2026 - Workflow Compiler");
    }
}
'@ | Set-Content test.txt

2. Generate run.xml
$workflowexe = "C:\Windows\Microsoft.NET\Framework64\v4.0.30319\Microsoft.Workflow.Compiler.exe"

[Reflection.Assembly]::LoadFrom($workflowexe) | Out-Null

$method = [Microsoft.Workflow.Compiler.CompilerWrapper].GetMethod(
    "SerializeInputToWrapper",
    [Reflection.BindingFlags]"NonPublic,Static"
)

Add-Type -Path "C:\Windows\Microsoft.NET\Framework64\v4.0.30319\System.Workflow.ComponentModel.dll"

$p = New-Object System.Workflow.ComponentModel.Compiler.WorkflowCompilerParameters
$p.GenerateInMemory = $true

$args2 = New-Object 'object[]' 2
$args2[0] = $p.PSObject.BaseObject
$args2[1] = [string[]]@("$PWD\test.txt")

$tmp = $method.Invoke($null,$args2)

Move-Item $tmp ".\run.xml" -Force

Quickly confirm:
Test-Path .\run.xml

You want:
True

3. Run the actual test
Then just:
whoami
Write-Host "Testing Microsoft.Workflow.Compiler.exe"

& $workflowexe ".\run.xml" ".\results.xml"

Write-Host "Exit code: $LASTEXITCODE"
